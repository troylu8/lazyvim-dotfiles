{
    "print something": {
        "prefix": "pr",
        "body": "println!(\"$0\");"
    },
    "pretty print something": {
        "prefix": "ppr",
        "body": "println!(\"{:?}\", $0);"
    },
    "derive something": {
        "prefix": "der",
        "body": "#[derive($0)]"
    },
    "debug print something": {
        "prefix": "db",
        "body": "dbg!($0);"
    },
    "bevy commands systemparam": {
        "prefix": "cmd",
        "body": "mut commands: Commands"
    }
}
