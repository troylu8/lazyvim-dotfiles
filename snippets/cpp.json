{
    "print something": {
        "prefix": "cou",
        "body": "std::cout << $1 << std::endl;$0",
        "description": "push to stdout"
    },
    
    "main function": {
        "prefix": "main",
        "body": [
            "int main() {",
            "\t",
            "\t$0",
            "\t",
            "\treturn 0;",
            "}"
        ]
    },
    
    "for i": {
        "prefix": "fori",
        "body": [
            "for (int i = 0; i < ${1:amt}; i++) {",
            "    $0",
            "}"
        ],
        "description": "for loop with i variable"
    },
    
    "include": {
        "prefix": "include",
        "body": "#include $0",
        "description": "include a header file"
    }
}
